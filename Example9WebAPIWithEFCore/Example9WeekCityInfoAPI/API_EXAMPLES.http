// ============================================================================
// COMMON CURL COMMANDS
// ============================================================================

/**
 * Get all cities
 */
curl -X GET "https://localhost:7000/api/cities" \
  -H "accept: application/json"

/**
 * Get specific city
 */
curl -X GET "https://localhost:7000/api/cities/1" \
  -H "accept: application/json"

/**
 * Create a city
 */
curl -X POST "https://localhost:7000/api/cities" \
  -H "Content-Type: application/json" \
  -d "{
    \"cityName\": \"Boston\",
    \"description\": \"The Hub\"
  }"

/**
 * Full update (PUT)
 */
curl -X PUT "https://localhost:7000/api/cities/1" \
  -H "Content-Type: application/json" \
  -d "{
    \"cityName\": \"New York City\",
    \"description\": \"Updated description\"
  }"

/**
 * Partial update (PATCH)
 */
curl -X PATCH "https://localhost:7000/api/cities/1" \
  -H "Content-Type: application/json-patch+json" \
  -d "[
    {\"op\": \"replace\", \"path\": \"/description\", \"value\": \"New desc\"}
  ]"

/**
 * Delete a city
 */
curl -X DELETE "https://localhost:7000/api/cities/1" \
  -H "accept: */*"

/**
 * Get all POIs for a city
 */
curl -X GET "https://localhost:7000/api/cities/1/pointsofinterest" \
  -H "accept: application/json"

/**
 * Create a POI
 */
curl -X POST "https://localhost:7000/api/cities/1/pointsofinterest" \
  -H "Content-Type: application/json" \
  -d "{
    \"nameofPOI\": \"Empire State Building\",
    \"description\": \"Iconic skyscraper\"
  }"

// ============================================================================
// HTTP STATUS CODES
// ============================================================================

/**
 * 200 OK
 * - Successful GET request
 * - Successful retrieval of data
 */

/**
 * 201 Created
 * - Successful POST request
 * - New resource created
 * - Location header contains URL to new resource
 */

/**
 * 204 No Content
 * - Successful PUT/PATCH/DELETE request
 * - No response body
 */

/**
 * 400 Bad Request
 * - Invalid request data
 * - Model validation failed
 * - Required fields missing
 */

/**
 * 404 Not Found
 * - Resource doesn't exist
 * - City or POI not found
 */

/**
 * 500 Internal Server Error
 * - Server error
 * - Unhandled exception
 */

// ============================================================================
// POSTMAN ENVIRONMENT SETUP
// ============================================================================

/**
 * Create a Postman collection with these variables:
 * 
 * {{base_url}} = https://localhost:7000
 * {{cityId}} = 1
 * {{poiId}} = 1
 * 
 * Use these in requests like:
 * GET {{base_url}}/api/cities/{{cityId}}
 */
