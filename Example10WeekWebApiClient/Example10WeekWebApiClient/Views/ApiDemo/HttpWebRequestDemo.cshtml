@model Example10WeekWebApiClient.Models.ApiDemoResultViewModel
@{
    ViewData["Title"] = "HttpWebRequest Demo";
}

<h2>@ViewData["Title"]</h2>
<p>Using <code>HttpWebRequest/HttpWebResponse</code> to call the TODO API.</p>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    <p><strong>Endpoint:</strong> @Model.EndpointUsed</p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Description</th>
                <th>Complete</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@item.IsComplete</td>
            </tr>
        }
        </tbody>
    </table>
}
