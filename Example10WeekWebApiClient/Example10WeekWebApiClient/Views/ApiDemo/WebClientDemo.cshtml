@model Example10WeekWebApiClient.Models.ApiDemoResultViewModel
@{
    ViewData["Title"] = "WebClient Demo";
}

<h2>@ViewData["Title"]</h2>
<p>Using <code>WebClient</code> to run full TODO API CRUD (<strong>GET, POST, PUT, DELETE</strong>).</p>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    <p><strong>Endpoint:</strong> @Model.EndpointUsed</p>

    @if (Model.OperationLogs.Count > 0)
    {
        <h5>CRUD operation results</h5>
        <ul>
            @foreach (var log in Model.OperationLogs)
            {
                <li>@log</li>
            }
        </ul>
    }

    <h5>Current TODO items (after CRUD demo)</h5>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Description</th>
                <th>Complete</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@item.IsComplete</td>
            </tr>
        }
        </tbody>
    </table>
}
