@{
    ViewData["Title"] = "REST API Client Demos";
}

<div class="text-center mb-4">
    <h1 class="display-5">C# REST API Consumption Demos</h1>
    <p>Choose a demo page to run full TODO REST CRUD (GET, POST, PUT, DELETE) using different C# client approaches.</p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">HttpWebRequest/Response</h5>
                <p class="card-text">Low-level and obsolete API, useful for legacy-style control and full CRUD demonstrations.</p>
                <a asp-controller="ApiDemo" asp-action="HttpWebRequestDemo" class="btn btn-primary">Open Demo</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">WebClient</h5>
                <p class="card-text">Simple API for quick HTTP calls, now demonstrated with full CRUD flow.</p>
                <a asp-controller="ApiDemo" asp-action="WebClientDemo" class="btn btn-primary">Open Demo</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">HttpClient</h5>
                <p class="card-text">Modern async API for HTTP requests and complete CRUD operations.</p>
                <a asp-controller="ApiDemo" asp-action="HttpClientDemo" class="btn btn-primary">Open Demo</a>
            </div>
        </div>
    </div>
</div>
