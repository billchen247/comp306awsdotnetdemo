@page "{id:int}"
@model Example5WeekWeb.Pages.Students.DeleteModel
@{
    ViewData["Title"] = "Delete Student";
}

<h1>Delete Student</h1>

<div>
    <h4>Are you sure you want to delete this student?</h4>
    <dl>
        <dt>Name</dt>
        <dd>@Model.Student.Name</dd>
        <dt>Enrollment Date</dt>
        <dd>@Model.Student.EnrollmentDate.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form method="post">
        <button type="submit">Delete</button>
        <a asp-page="/Students/Index">Cancel</a>
    </form>
</div>
