@model Example5WeekWeb.Models.TodoItem

@{
    ViewData["Title"] = "Delete Todo";
}

<h1>Delete Todo</h1>

<div>
    <h4>Are you sure you want to delete this?</h4>
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        <dt class="col-sm-2">Due</dt>
        <dd class="col-sm-10">@(Model.DueDate?.ToString("yyyy-MM-dd") ?? "")</dd>
        <dt class="col-sm-2">Done</dt>
        <dd class="col-sm-10">@(Model.IsDone ? "Yes" : "No")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
    </form>
</div>