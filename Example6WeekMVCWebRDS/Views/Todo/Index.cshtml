@model IEnumerable<Example6WeekMVCWebRDS.Models.TodoItem>

@{
    ViewData["Title"] = "Todos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/todo.css" />
}

<h1>Todos</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<form method="get" asp-action="Index" class="form-inline mb-3">
    <div class="input-group">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by title..." />
        <div class="input-group-append">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty((string?)ViewData["CurrentFilter"]))
    {
        <a asp-action="Index" class="btn btn-link">Clear</a>
    }
</form>
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Due</th>
            <th>Completed</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Title</td>
            <td>@(item.DueAt?.ToString("yyyy-MM-dd") ?? "")</td>
            <td>@(item.IsCompleted ? "Yes" : "No")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
